# ============================================================
#  Настройки сервера (Docker).
#  Этот файл — шаблон. На сервере создайте .env.deploy на его основе
#  и замените все CHANGE_ME.
#
#  Запуск:  docker compose --env-file .env.deploy up -d --build
# ============================================================

# --- Django ---
DEBUG=False
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE_ME_SECRET_KEY
ALLOWED_HOSTS=izo-studio.ru,www.izo-studio.ru
CSRF_TRUSTED_ORIGINS=https://izo-studio.ru,https://www.izo-studio.ru,http://izo-studio.ru,http://www.izo-studio.ru

# --- База данных ---
# Отдельного сервиса БД нет: SQLite-файл лежит в ./data/db.sqlite3 (bind-mount).
# Ничего настраивать не нужно.

# --- Gunicorn ---
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# --- Nginx Proxy Manager ---
# Имя docker-сети, в которой живёт NPM. Посмотреть: docker network ls
# Обычно npm_default / nginx-proxy-manager_default / npm-app_default.
# Контейнер izostudio-nginx подключается к ней, и NPM проксирует на izostudio-nginx:80
NPM_NETWORK=npm_default

# --- HTTPS (раскомментировать, когда сайт реально отдаётся по https) ---
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
