# ============================================================
#  Настройки сервера (Docker).
#  Этот файл — шаблон. На сервере создайте .env.deploy на его основе
#  и замените все CHANGE_ME.
#
#  Запуск:  docker compose --env-file .env.deploy up -d --build
# ============================================================

# --- Django ---
DEBUG=False
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE_ME_SECRET_KEY
ALLOWED_HOSTS=izo-studio.ru,www.izo-studio.ru
CSRF_TRUSTED_ORIGINS=https://izo-studio.ru,https://www.izo-studio.ru,http://izo-studio.ru,http://www.izo-studio.ru

# --- База данных (MySQL из compose) ---
DATABASE_ENGINE=mysql
DATABASE_NAME=_izo
# На существующем томе MySQL пользователь должен совпадать с уже созданным там
DATABASE_USER=AnreX
DATABASE_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
DATABASE_HOST=db
DATABASE_PORT=3306

# --- Gunicorn ---
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# --- HTTPS (раскомментировать, когда сайт реально отдаётся по https) ---
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
